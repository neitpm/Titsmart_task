# Database Connection (Local Docker Container)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Cryptographic Keys (Bắt buộc độ dài tối thiểu 32 ký tự, KHÔNG dùng fallback)
JWT_SECRET=workcore-production-grade-jwt-secret-key-32chars-minimum-2026-auth
INTERNAL_GATEWAY_SECRET=workcore-mesh-internal-secret-gateway-to-services-signature-token-2026
JWT_EXPIRES_IN=8h

